# TTS defaults. Copy to .env in the project root. CLI flags override these values;
# exported environment variables override .env. Keep API keys out of Git.
TTS_ENABLED=true
TTS_PROVIDER=fishspeech
# For a remote GPU server, use its externally reachable host and port.
TTS_API_BASE_URL=http://127.0.0.1:8002
TTS_MODEL=s2-pro
TTS_API_KEY=
# Fish auto-detects language from text; Qwen maps ja to Japanese.
TTS_LANGUAGE=ja

# RoleTone scoring defaults.
HF_HOME=./modelsweights/huggingface
HF_HUB_DISABLE_XET=1
NUMBA_CACHE_DIR=/private/tmp/roletone_numba_cache

# Optional: if set, this is passed to transformers from_pretrained(cache_dir=...).
# ROLETONE_CACHE_DIR=./modelsweights/transformers-cache

# Recommended for speaker/timbre similarity.
ROLETONE_MODEL=wavlm-base-plus-sv
ROLETONE_EMBEDDING_MODE=auto
ROLETONE_DEVICE=auto
ROLETONE_SAMPLE_RATE=16000
ROLETONE_TRIM_TOP_DB=30
ROLETONE_MATCH_THRESHOLD=0.86
ROLETONE_LIKELY_THRESHOLD=0.75
ROLETONE_BORDERLINE_THRESHOLD=0.65

# Enable after the model cache is present and you want fully offline scoring.
# ROLETONE_LOCAL_FILES_ONLY=1
